rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Gravações de ligações — só membros da própria conta podem enviar/ouvir
    match /contas/{contaId}/gravacoes/{arquivo} {
      function isMembro() {
        return request.auth != null &&
          firestore.exists(/databases/(default)/documents/contas/$(contaId)/usuarios/$(request.auth.uid));
      }

      allow read, write: if isMembro();
    }
  }
}

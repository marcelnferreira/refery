# ============================================
# REFERY — Variáveis de Ambiente
# ============================================
# Copie este arquivo para .env e preencha os valores do Firebase
# cp .env.example .env

# ------------------------------------------
# FIREBASE (obrigatório)
# Obtenha em: console.firebase.google.com > Configurações do projeto > Seus apps
# ------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ------------------------------------------
# UAZAPI — WhatsApp (opcional)
# Configurado em Configurações > Integrações dentro do CRM
# ------------------------------------------
# UAZAPI_SUBDOMAIN=
# UAZAPI_TOKEN=
